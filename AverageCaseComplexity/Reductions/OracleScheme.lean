module

public import AverageCaseComplexity.Classes
public import AverageCaseComplexity.Reductions.OracleMachine

@[expose] public section

/-!
# Certified deterministic oracle schemes

The certificate contains a real finite-control binary multitape oracle machine.
Every instruction, including query submission, consumes one unit of the library
machine clock. Query writing and answer reading consume ordinary instructions;
the oracle's own computation is external. The sole oracle returns one Boolean.

We require actual halting by the fixed polynomial clock for every language oracle,
not merely an output observed when a still-live computation is cut off. Outputs
must use the existing two-bit answer encoding. Uniformity over all oracles is a deliberate stronger requirement than the
paper's displayed true-target-oracle effectiveness condition. Conversion from
target-only polynomial runtime to this convention is not proved here. The
distributional conditions refer only to the true target oracle.
-/

namespace AverageCaseComplexity

/-- One fixed polynomial in the full encoded scheme-input length. -/
def oracleClock (coefficient degree : ℕ) (a : Word × Accuracy) : ℕ :=
  coefficient * ((schemeInputEncoding a).length + 1) ^ degree

/-- Decode the two-bit answer format. Invalid words default to give-up, but certified
schemes below are required to produce a valid encoding, so this default is never used. -/
def decodeOracleAnswer : Word → Answer
  | [true, b] => some b
  | _ => none

@[simp] theorem decodeOracleAnswer_encode (a : Answer) :
    decodeOracleAnswer (answerEncoding a) = a := by
  cases a <;> rfl

/-- A deterministic oracle machine with a uniform polynomial halting certificate.
`Fin stateCount`, `Bool`, and `Unit` provide finite control, alphabet, and channels. -/
structure PolyTimeOracleScheme where
  workTapes : ℕ
  stateCount : ℕ
  machine : OracleMachine workTapes stateCount
  coefficient : ℕ
  degree : ℕ
  halts : ∀ (L : Language) (a : Word × Accuracy),
    (OracleMachine.run machine L (oracleClock coefficient degree a)
      (schemeInputEncoding a)).1.tapes.state = none
  output_valid : ∀ (L : Language) (a : Word × Accuracy),
    ∃ answer : Answer,
      (OracleMachine.run machine L (oracleClock coefficient degree a)
        (schemeInputEncoding a)).1.tapes.output = answerEncoding answer

namespace PolyTimeOracleScheme

/-- The certified instruction budget. -/
def clock (T : PolyTimeOracleScheme) (x : Word) (k : Accuracy) : ℕ :=
  oracleClock T.coefficient T.degree (x, k)

/-- The clock's size parameter is exactly `|x| + k + 2`. -/
theorem clock_eq (T : PolyTimeOracleScheme) (x : Word) (k : Accuracy) :
    T.clock x k = T.coefficient * (x.length + k.val + 2) ^ T.degree := by
  simp [clock, oracleClock, schemeInputEncoding, Nat.add_assoc]

/-- Actual execution, retaining the final configuration and chronological query/reply trace. -/
def execution (T : PolyTimeOracleScheme) (L : Language) (x : Word) (k : Accuracy) :=
  OracleMachine.run T.machine L (T.clock x k) (schemeInputEncoding (x, k))

/-- The deterministic answer with an exact Boolean language oracle. -/
def run (T : PolyTimeOracleScheme) (L : Language) : DeterministicScheme :=
  fun x k => decodeOracleAnswer (T.execution L x k).1.tapes.output

/-- The same machine as a typed oracle program, suitable for later oracle substitution.
It is not an arbitrary program with an asserted runtime: it is generated by the certified table. -/
def program (T : PolyTimeOracleScheme) (a : Word × Accuracy) :
    Cslib.OracleComp (fun _ : Word => Bool) Answer :=
  (fun cfg => decodeOracleAnswer cfg.tapes.output) <$>
    OracleMachine.program T.machine (T.clock a.1 a.2) (schemeInputEncoding a)

/-- The program interpretation agrees with deterministic execution. -/
theorem interpret_program (T : PolyTimeOracleScheme) (L : Language)
    (x : Word) (k : Accuracy) :
    Cslib.OracleComp.interpret (fun y : Word => (pure (L y) : Id Bool))
      (T.program (x, k)) = T.run L x k := by
  simp only [program, Cslib.OracleComp.interpret_map, OracleMachine.interpret_program]
  rfl

/-- All completed oracle calls, in chronological order and including repetitions. -/
def trace (T : PolyTimeOracleScheme) (L : Language) (x : Word) (k : Accuracy) :
    List (Word × Bool) := (T.execution L x k).2

/-- Query words alone, still retaining repeated occurrences. -/
def queryWords (T : PolyTimeOracleScheme) (L : Language) (x : Word) (k : Accuracy) :
    List Word := (T.trace L x k).map Prod.fst

/-- The paper's queried-at-least-once event. This does not count repeated calls. -/
def Asks (T : PolyTimeOracleScheme) (L : Language) (x : Word) (k : Accuracy)
    (y : Word) : Prop := y ∈ T.queryWords L x k

instance decidableAsks (T : PolyTimeOracleScheme) (L : Language)
    (x : Word) (k : Accuracy) (y : Word) : Decidable (T.Asks L x k y) :=
  inferInstanceAs (Decidable (y ∈ T.queryWords L x k))

/-- The paper's zero-one query indicator, not the number of occurrences. -/
def askIndicator (T : PolyTimeOracleScheme) (L : Language) (x : Word) (k : Accuracy)
    (y : Word) : ℕ := if T.Asks L x k y then 1 else 0

@[simp] theorem askIndicator_eq_one (T : PolyTimeOracleScheme) (L : Language)
    (x : Word) (k : Accuracy) (y : Word) :
    T.askIndicator L x k y = 1 ↔ T.Asks L x k y := by
  simp [askIndicator]

/-- The actual query count is bounded by the machine's polynomial clock. -/
theorem trace_length_le (T : PolyTimeOracleScheme) (L : Language) (x : Word) (k : Accuracy) :
    (T.trace L x k).length ≤ T.clock x k :=
  OracleMachine.queryCount_run_le T.machine L (T.clock x k) (schemeInputEncoding (x, k))

/-- Every submitted query has length at most that same clock. -/
theorem query_length_le (T : PolyTimeOracleScheme) (L : Language)
    (x : Word) (k : Accuracy) (y : Word) (h : T.Asks L x k y) :
    y.length ≤ T.clock x k := by
  obtain ⟨entry, hentry, hy⟩ := List.mem_map.mp h
  have hb := OracleMachine.requestLength_run_le T.machine L (T.clock x k)
    (schemeInputEncoding (x, k)) entry hentry
  simpa only [hy] using hb

/-- Decoding a certified output loses no information. -/
theorem output_eq_encoding_run (T : PolyTimeOracleScheme) (L : Language)
    (x : Word) (k : Accuracy) :
    (T.execution L x k).1.tapes.output = answerEncoding (T.run L x k) := by
  obtain ⟨answer, h⟩ := T.output_valid L (x, k)
  change (T.execution L x k).1.tapes.output = answerEncoding
    (decodeOracleAnswer (T.execution L x k).1.tapes.output)
  change (T.execution L x k).1.tapes.output = answerEncoding answer at h
  rw [h, decodeOracleAnswer_encode]

end PolyTimeOracleScheme

end AverageCaseComplexity
